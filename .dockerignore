# Контекст сборки Docker. Без этого файла COPY копирует локальные
# артефакты, и macOS/Linux-бинарники нативных модулей из node_modules
# (sharp, @napi-rs/canvas) затёрли бы установленные в образе.

.git
.gitignore
node_modules
**/node_modules
.pnpm-store
dist
**/dist
build

# Секреты
.env
.env.*
**/.env
**/.env.*

# Runtime-каталоги
uploads
reports
.tessdata

# Тестовые артефакты и семплы
backend/samples
**/samples/*.xlsx
**/samples/*.pdf
**/samples/out

# Локальное и редакторское
.opencode
AGENTS.md
test
*.log
.DS_Store
.idea
.vscode

# ============================================================================
# Reconciliation AI — САМОДОСТАТОЧНЫЙ ALL-IN-ONE ОБРАЗ
#
# Внутри одного контейнера работают 3 процесса (supervisord):
#   1. Ollama     — локальная LLM (модель запечена в образ, интернет не нужен)
#   2. Backend    — Fastify API (порт 5057)
#   3. Frontend   — Vite dev-сервер (порт 3000, проксирует /api на backend)
#
# СЕКРЕТОВ В ОБРАЗЕ НЕТ: режим REQUIRE_LOCAL_ONLY=true не использует никаких
# API-ключей. Всё поведение настраивается обычными ENV при запуске.
#
# СБОРКА ТРЕБУЕТ ИНТЕРНЕТ (apt, pnpm, ollama pull). Целевая машина — нет:
# она получает уже готовый образ через docker load. Не путайте стороны.
#
# Сборка (на машине с интернетом и достаточным диском ~20 ГБ):
#   docker build -f Dockerfile.allinone -t recon-ai:local .
#
# ОБЯЗАТЕЛЬНАЯ ПРОВЕРКА после сборки — модель должна быть внутри образа:
#   docker run --rm recon-ai:local ollama list
# Если модели нет, пересоберите образ: сборка специально падает на этом шаге.
#
# Экспорт для переноса на другую машину (без реестра):
#   docker save recon-ai:local | gzip > recon-ai-local.tar.gz
# На целевой машине:
#   docker load < recon-ai-local.tar.gz
#
# Запуск:
#   docker run -d -p 3000:3000 -p 5057:5057 --name recon-ai recon-ai:local
#   Открыть http://localhost:3000
#
# GPU (NVIDIA) на мощной машине — просто добавьте флаг, без пересборки:
#   docker run -d --gpus=all -p 3000:3000 ...
# Без GPU всё работает на CPU (медленнее, но полностью функционально).
# ============================================================================

FROM node:20-bookworm-slim AS app

ENV DEBIAN_FRONTEND=noninteractive

RUN corepack enable \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 make g++ curl ca-certificates unzip git supervisor \
 && rm -rf /var/lib/apt/lists/*

# --- Ollama (CPU-версия; CUDA-библиотеки подгрузятся рантаймом при --gpus) ---
RUN curl -fsSL https://ollama.com/install.sh | sh

WORKDIR /app

# Манифесты workspace — pnpm разберётся с @recon/shared
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY shared/package.json shared/
COPY backend/package.json backend/
COPY frontend/package.json frontend/

RUN pnpm install --frozen-lockfile

COPY shared/ shared/
COPY backend/ backend/
COPY frontend/ frontend/

# Конфигурация всех процессов внутри контейнера (без секретов).
# BACKEND_URL используется vite-прокси: /api -> http://127.0.0.1:5057
ENV NODE_ENV=production \
    AI_PROVIDER=ollama \
    REQUIRE_LOCAL_ONLY=true \
    OLLAMA_BASE_URL=http://127.0.0.1:11434 \
    OLLAMA_MODEL=qwen2.5:7b-instruct \
    PORT=5057 \
    BACKEND_URL=http://127.0.0.1:5057

# --- ЗАПЕКАЕНИЕ МОДЕЛИ В ОБРАЗ -----------------------------------------------
# Модель скачивается один раз при сборке и хранится в /root/.ollama внутри
# образа. Контейнер запускается на любой машине БЕЗ интернета и БЕЗ шага
# `ollama pull`. Размер слоя ≈ размер модели (~4.7 ГБ для qwen2.5:7b-instruct).
#
# ВАЖНО: ошибка `ollama pull` ОБЯЗАНА ломать сборку. Раньше цепочка
# заканчивалась на `|| true` — из-за приоритета `&&` этот `true` перехватывал
# ошибку pull, и Docker рапортовал об успешной сборке образа БЕЗ модели.
# На офлайн-машине это выглядело бы как «всё работает, но AI отключился».
# Теперь падение честно останавливает сборку, а `|| true` стоит только
# у pkill, которому он и нужен (процесс мог завершиться сам).
#
# Меняете модель? Достаточно поменять OLLAMA_MODEL выше — он используется
# и для pull, и для проверки. Дублировать имя модели вручную не нужно.
RUN set -eu; \
    MODEL="${OLLAMA_MODEL:?OLLAMA_MODEL не задан}"; \
    ollama serve & \
    OLLAMA_PID=$!; \
    READY=0; \
    for i in $(seq 1 60); do \
        if ollama list >/dev/null 2>&1; then READY=1; break; fi; \
        sleep 1; \
    done; \
    if [ "$READY" -ne 1 ]; then \
        echo "ОШИБКА: Ollama не ответил за 60 с — прерываю сборку" >&2; \
        kill "$OLLAMA_PID" 2>/dev/null || true; \
        exit 1; \
    fi; \
    echo "Ollama готов, загружаю ${MODEL}"; \
    ollama pull "$MODEL"; \
    ollama list | grep -q "${MODEL%%:*}" || { \
        echo "ОШИБКА: модель ${MODEL} отсутствует после pull — прерываю сборку" >&2; \
        kill "$OLLAMA_PID" 2>/dev/null || true; \
        exit 1; \
    }; \
    echo "Модель ${MODEL} запечена в образ"; \
    kill "$OLLAMA_PID" 2>/dev/null || true

COPY supervisord.conf /etc/supervisor/conf.d/recon.conf

EXPOSE 3000 5057

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/recon.conf"]

# ============================================================================
# Reconciliation AI — САМОДОСТАТОЧНЫЙ ALL-IN-ONE ОБРАЗ
#
# Внутри одного контейнера работают 3 процесса (supervisord):
#   1. Ollama     — локальная LLM (модель запечена в образ, интернет не нужен)
#   2. Backend    — Fastify API (порт 5057)
#   3. Frontend   — Vite dev-сервер (порт 5173, проксирует /api на backend)
#
# СЕКРЕТОВ В ОБРАЗЕ НЕТ: режим REQUIRE_LOCAL_ONLY=true не использует никаких
# API-ключей. Всё поведение настраивается обычными ENV при запуске.
#
# Сборка (на машине с интернетом и достаточным диском ~20 ГБ):
#   docker build -f Dockerfile.allinone -t recon-ai:local .
#
# Экспорт для переноса на другую машину (без реестра):
#   docker save recon-ai:local | gzip > recon-ai-local.tar.gz
# На целевой машине:
#   docker load < recon-ai-local.tar.gz
#
# Запуск:
#   docker run -d -p 5173:5173 -p 5057:5057 --name recon-ai recon-ai:local
#   Открыть http://localhost:5173
#
# GPU (NVIDIA) на мощной машине — просто добавьте флаг, без пересборки:
#   docker run -d --gpus=all -p 5173:5173 ...
# Без GPU всё работает на CPU (медленнее, но полностью функционально).
# ============================================================================

FROM node:20-bookworm-slim AS app

ENV DEBIAN_FRONTEND=noninteractive

RUN corepack enable \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 make g++ curl ca-certificates unzip git supervisor \
 && rm -rf /var/lib/apt/lists/*

# --- Ollama (CPU-версия; CUDA-библиотеки подгрузятся рантаймом при --gpus) ---
RUN curl -fsSL https://ollama.com/install.sh | sh

WORKDIR /app

# Манифесты workspace — pnpm разберётся с @recon/shared
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY shared/package.json shared/
COPY backend/package.json backend/
COPY frontend/package.json frontend/

RUN pnpm install --frozen-lockfile

COPY shared/ shared/
COPY backend/ backend/
COPY frontend/ frontend/

# Конфигурация всех процессов внутри контейнера (без секретов).
# BACKEND_URL используется vite-прокси: /api -> http://127.0.0.1:5057
ENV NODE_ENV=production \
    AI_PROVIDER=ollama \
    REQUIRE_LOCAL_ONLY=true \
    LOCAL_FALLBACK_ENABLED=false \
    OLLAMA_BASE_URL=http://127.0.0.1:11434 \
    OLLAMA_MODEL=qwen2.5:7b-instruct \
    PORT=5057 \
    BACKEND_URL=http://127.0.0.1:5057

# --- ЗАПЕКАЕНИЕ МОДЕЛИ В ОБРАЗ -----------------------------------------------
# Модель скачивается один раз при сборке и хранится в /root/.ollama внутри
# образа. Контейнер запускается на любой машине БЕЗ интернета и БЕЗ шага
# `ollama pull`. Размер слоя ≈ размер модели (~4.7 ГБ для qwen2.5:7b-instruct).
#
# Меняете модель? Поменяйте OLLAMA_MODEL выше И строку pull ниже, затем
# пересоберите образ.
RUN ollama serve & \
    sleep 5 && \
    ollama pull qwen2.5:7b-instruct && \
    pkill -f "ollama serve" || true

COPY supervisord.conf /etc/supervisor/conf.d/recon.conf

EXPOSE 5173 5057 11434

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/recon.conf"]

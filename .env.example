# ============================================================================
# Reconciliation AI — пример конфигурации
#
# ВАЖНО: два разных .env.
#   backend/.env  — читает dotenv в backend/src/index.ts (обычная локальная разработка)
#   ./.env         — читает env_file в docker-compose.yml (контейнерный запуск)
# Копируйте нужный:  cp .env.example backend/.env   или   cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# Режим AI
# ----------------------------------------------------------------------------
# true (по умолчанию) — используется ТОЛЬКО локальная модель Ollama:
#   облачные вызовы (OpenRouter) заблокированы, fallback-цепочки отключены,
#   при недоступности Ollama система деградирует к эвристикам/правилам.
# false — облачный режим и graceful degradation через fallback-цепочки.
#
# ⚠️ Существующим установкам, у которых заполнен только OPENROUTER_API_KEY,
#    нужно явно выставить false, иначе AI перестанет работать.
REQUIRE_LOCAL_ONLY=true

# Провайдер AI: openrouter | ollama.
# Игнорируется, пока REQUIRE_LOCAL_ONLY=true (тогда провайдер всегда ollama).
AI_PROVIDER=ollama

# ----------------------------------------------------------------------------
# Локальные модели (Ollama) — основной режим
# ----------------------------------------------------------------------------
# Адрес Ollama (OpenAI-совместимый API /v1/chat/completions).
#   На хосте:                    http://localhost:11434
#   Внутри docker-compose:       http://ollama:11434
#   Ollama на хосте из контейнера: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434

# Модель по умолчанию; должна быть скачана: ollama pull qwen2.5:7b-instruct
OLLAMA_MODEL=qwen2.5:7b-instruct

# Ключ для Ollama не нужен. Заполняйте, только если Ollama стоит за прокси
# с авторизацией — значение подставляется в заголовок Authorization: Bearer.
OLLAMA_API_KEY=

# Цепочка запасных локальных моделей (graceful degradation).
# Активна ТОЛЬКО при REQUIRE_LOCAL_ONLY=false. Пустое значение отключает цепочку.
OLLAMA_FALLBACK_MODELS=qwen2.5:3b-instruct,llama3.2:3b

# ----------------------------------------------------------------------------
# Облачные модели (OpenRouter) — активны только при REQUIRE_LOCAL_ONLY=false
# ----------------------------------------------------------------------------
# Ключ OpenRouter (https://openrouter.ai/keys). Без ключа система работает
# в деградированном режиме: структура определяется эвристиками, гипотезы — по правилам.
OPENROUTER_API_KEY=

# Модель OpenRouter по умолчанию. Любая модель с поддержкой JSON-выхода.
# Рекомендуется для двухсторонних актов: nvidia/nemotron-3-ultra:free
# Для эвристики структуры: openai/gpt-4o-mini, anthropic/claude-3.5-haiku
OPENROUTER_MODEL=nvidia/nemotron-3-ultra:free

# Цепочка запасных облачных моделей через запятую.
# НЕ задавайте пустое значение, если нужен fallback: пустая строка ОТКЛЮЧАЕТ цепочку.
# По умолчанию (переменная не задана): llama-3-70b, mistral-large.
# Бюджет запросов: основная модель до 2 попыток, каждая fallback — 1.
# AI_FALLBACK_MODELS=

# ----------------------------------------------------------------------------
# Сервер
# ----------------------------------------------------------------------------
# Порт backend (5000 занят AirPlay на macOS — используем 5057)
PORT=5057

# Максимальный размер одного файла, МБ
MAX_FILE_MB=50

# Уровень логов fastify (fatal, error, warn, info, debug)
LOG_LEVEL=info

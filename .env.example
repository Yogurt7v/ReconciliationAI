# Ключ OpenRouter (https://openrouter.ai/keys). Без ключа система работает
# в деградированном режиме: структура определяется эвристиками, гипотезы — по правилам.
OPENROUTER_API_KEY=

# Модель OpenRouter по умолчанию. Любая модель с поддержкой JSON-выхода.
# Рекомендуется для двухсторонних актов: nvidia/nemotron-3-ultra:free
# Для эвристики структуры: openai/gpt-4o-mini, anthropic/claude-3.5-haiku
OPENROUTER_MODEL=nvidia/nemotron-3-ultra:free

# --- Локальные модели через Ollama -------------------------------------------
# Провайдер AI: openrouter (по умолчанию) | ollama
AI_PROVIDER=openrouter

# Адрес сервера Ollama (OpenAI-совместимый API).
# На хосте:            http://localhost:11434
# В docker-compose:    http://ollama:11434  (или host.docker.internal для Desktop)
OLLAMA_BASE_URL=http://localhost:11434

# Модель Ollama по умолчанию (должна быть скачана: ollama pull qwen2.5:7b-instruct)
OLLAMA_MODEL=qwen2.5:7b-instruct

# Цепочка запасных локальных моделей через запятую (graceful degradation)
OLLAMA_FALLBACK_MODELS=qwen2.5:3b-instruct,llama3.2:3b
# --- Режим "только локальная модель" ----------------------------------------
# true (по умолчанию): облачные распознаватели (OpenRouter) ПОЛНОСТЬЮ отключены,
# fallback на другие модели отключен. Используется ровно одна локальная модель
# Ollama из OLLAMA_MODEL. При недоступности Ollama — деградация к эвристикам.
# false: возвращаются облачный режим и graceful degradation через fallback-цепочки.
REQUIRE_LOCAL_ONLY=true

# Только для REQUIRE_LOCAL_ONLY=false: включать ли fallback-цепочку локальных моделей
LOCAL_FALLBACK_ENABLED=false


# Порт backend (5000 занят AirPlay на macOS — используем 5057)
PORT=5057

# Максимальный размер одного файла, МБ
MAX_FILE_MB=50

# Уровень логов fastify (fatal, error, warn, info, debug)
LOG_LEVEL=info
